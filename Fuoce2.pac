//  HELPER FUNCTIONS — ULTRA OPTIMIZED
// ═══════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════

function maskFromCIDR(c) {
    var m = {
        "8":"255.0.0.0","10":"255.192.0.0","11":"255.224.0.0",
        "12":"255.240.0.0","13":"255.248.0.0","14":"255.252.0.0",
        "15":"255.254.0.0","16":"255.255.0.0","17":"255.255.128.0",
        "18":"255.255.192.0","19":"255.255.224.0","20":"255.255.240.0",
        "21":"255.255.248.0","22":"255.255.252.0"
    };
    return m[c] || "255.255.0.0";
}

function isJordanIP(ip) {
    if (!ip || ip.indexOf(":") !== -1) return false;
    for (var i = 0; i < JO_NETS.length; i++) {
        if (isInNet(ip, JO_NETS[i][0], maskFromCIDR(JO_NETS[i][1]))) return true;
    }
    return false;
}

function detectMode(host) {
    var h = host.toLowerCase();
    
    // Priority order: Social/Recruit > Lobby > Game > Voice > Auth > CDN
    var orderedModes = ["SOCIAL_FORCE", "LOBBY_FORCE", "GAME_CRITICAL", "VOICE", "AUTH", "CDN"];
    
    for (var m = 0; m < orderedModes.length; m++) {
        var mode = orderedModes[m];
        var sigs = MODES[mode].sig;
        for (var i = 0; i < sigs.length; i++) {
            if (h.indexOf(sigs[i]) !== -1) {
                return mode;
            }
        }
    }
    return "GAME_CRITICAL";
}

function getJordanProxyList(mode) {
    var m = MODES[mode];
    var list = [];
    
    if (m.strategy === "SOCIAL_ULTRA_FORCE") {
        // Maximum power for recruitment
        list = [
            PROXY.SOCIAL_ORANGE, PROXY.SOCIAL_ZAIN, PROXY.SOCIAL_UMNIAH, PROXY.SOCIAL_JT,
            PROXY.LOBBY_ORANGE, PROXY.LOBBY_ZAIN
        ];
    } 
    else if (m.strategy === "LOBBY_ULTRA_FORCE") {
        list = [
            PROXY.LOBBY_ORANGE, PROXY.LOBBY_ZAIN, PROXY.LOBBY_UMNIAH, PROXY.LOBBY_JT,
            PROXY.SOCIAL_ORANGE, PROXY.GAME_ORANGE
        ];
    } 
    else if (m.strategy === "GAME_CRITICAL") {
        list = [
            PROXY.GAME_ORANGE, PROXY.GAME_ZAIN, PROXY.GAME_UMNIAH, PROXY.GAME_JT,
            PROXY.FAST_ORANGE, PROXY.FAST_ZAIN, PROXY.FAST_UMNIAH
        ];
    } 
    else if (m.strategy === "VOICE_CRITICAL") {
        list = [PROXY.VOICE_ORANGE, PROXY.VOICE_ZAIN, PROXY.GAME_ORANGE];
    } 
    else if (m.strategy === "SECURE_CRITICAL") {
        list = [PROXY.AUTH_ORANGE, PROXY.AUTH_ZAIN, PROXY.LOBBY_ZAIN];
    } 
    else {
        // CDN / fallback
        list = [PROXY.FAST_ORANGE, PROXY.FAST_ZAIN, PROXY.FAST_UMNIAH, PROXY.FAST_JT];
    }
    
    return list;
}

function buildProxyChain(proxyList, fallback) {
    var chain = [];
    for (var i = 0; i < proxyList.length; i++) {
        var p = proxyList[i];
        chain.push("PROXY " + p.ip + ":" + p.port);
    }
    if (fallback) chain.push(fallback);
    return chain.join("; ");
}

function isPubgDomain(h) {
    for (var i = 0; i < PUBG_KEYS.length; i++) {
        if (h.indexOf(PUBG_KEYS[i]) !== -1) return true;
    }
    return false;
}

// ═══════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════
//  MAIN FUNCTION — THE ULTIMATE ROUTER
// ═══════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════

function FindProxyForURL(url, host) {
    if (!host) return BLOOD.DIR;
    
    var h = host.toLowerCase();
    
    // Bypass local/private
    if (isPlainHostName(host) ||
        isInNet(host, "10.0.0.0", "255.0.0.0") ||
        isInNet(host, "127.0.0.0", "255.0.0.0") ||
        isInNet(host, "192.168.0.0", "255.255.0.0") ||
        isInNet(host, "172.16.0.0", "255.240.0.0")) {
        return BLOOD.DIR;
    }
    
    // Only route PUBG traffic
    if (!isPubgDomain(h)) {
        return BLOOD.DIR;
    }
    
    var ip = dnsResolve(host);
    
    // If resolved IP is already Jordan — direct (rare)
    if (ip && isJordanIP(ip)) {
        return BLOOD.DIR;
    }
    
    // Detect mode with highest precision
    var mode = detectMode(host);
    
    // Get strongest Jordan-only proxy chain
    var proxyList = getJordanProxyList(mode);
    var route = buildProxyChain(proxyList, BLOOD.BLK);
    
    return route;
}

